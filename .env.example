# ==============================================================================
# LeakGuard — GitHub Pull Request Integration Environment Configuration
# ==============================================================================

# 1. GitHub Webhook Secret (used to verify incoming webhooks from GitHub)
# Copy this secret into GitHub Repository Settings -> Webhooks -> Secret field
GITHUB_WEBHOOK_SECRET=lg_whsec_8f9a2b4c6e1d3f5a7b9c2e4f6a8b0c1d

# 2. GitHub Authentication (Choose Option A OR Option B)

# OPTION A: Personal Access Token (PAT) — Recommended for fast setup
# Generate at: GitHub -> Settings -> Developer Settings -> Personal Access Tokens (Classic)
# Required permissions: 'repo' (or 'public_repo' for open-source)
GITHUB_TOKEN=ghp_your_personal_access_token_here

# OPTION B: GitHub App Credentials — Recommended for orgs & enterprise
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_INSTALLATION_ID=98765432

# 3. LeakGuard Server Config
LEAKGUARD_HOST=0.0.0.0
LEAKGUARD_PORT=8000
LEAKGUARD_BASE_URL=http://localhost:8000
LEAKGUARD_PORTAL_URL=http://localhost:3000
LEAKGUARD_API_URL=http://localhost:8000

# 4. LLM Provider (optional — AI explanations fall back gracefully if unavailable)
# LEAKGUARD_LLM_API_KEY=sk-...
# LEAKGUARD_LLM_MODEL=gpt-4o
# LEAKGUARD_OLLAMA_ENDPOINT=http://localhost:11434
# LEAKGUARD_OLLAMA_MODEL=qwen2.5-coder:7b
